# Copy to .env and fill in. NEVER commit .env. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (PostgreSQL 13+) ---
DATABASE_URL=postgres://vyra:CHANGE_ME@localhost:5432/vyra
# Set true for managed Postgres (e.g. RDS). DB_SSL_REJECT_UNAUTHORIZED=false only if you cannot supply the CA.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# --- Auth secrets (>= 32 chars, different from each other) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- HTTP ---
# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:5173
# Number of reverse-proxy hops in front of Node (Nginx = 1; Vercel proxy = 1, +1 for a host load balancer like Render/Railway).
# Needed for correct client IPs / rate limiting — with 0 behind a proxy, all users share one rate-limit bucket.
TRUST_PROXY=0
# Public URL of the web app (used to build password-reset links).
APP_URL=http://localhost:5173
# Cookies are Secure by default in production. Override only if needed.
COOKIE_SECURE=
COOKIE_DOMAIN=                   # leave EMPTY behind the Vercel /api proxy (cookie belongs to the web app's host)

# --- Notifications (OTP / password reset delivery) ---
# console  = print messages to the server log (development only)
# disabled = refuse to send (safe default until an SMS/email provider is wired in)
NOTIFY_DRIVER=console            # console (dev: logs OTPs!) | disabled | webhook
# NOTIFY_WEBHOOK_URL=https://sms-email-gateway.example.com/send   # required for webhook; https in production
# NOTIFY_WEBHOOK_SECRET=            # >= 32 chars; the gateway verifies X-Vyra-Signature with it
# NOTIFY_TIMEOUT_MS=8000
# JOBS_ENABLED=true                 # outbox worker + retention purge; run in one or several processes
# Development-only fixed OTP so you can test registration without an SMS gateway. Forbidden in production.
OTP_DEV_CODE=1234

# --- Private object storage for prescriptions / documents ---
# Leave blank to use the local-disk driver (var/private-uploads/) — fine for a single-node deployment.
# Set all four to switch to an S3-compatible bucket.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Payments (Phase 5) ---
# Verifies inbound webhooks from the "manual" (bank transfer / wallet reference) provider. Required in production.
PAYMENTS_MANUAL_WEBHOOK_SECRET=

# --- Field-level encryption (Phase 6) ---
# Encrypts seller settlement (bank/wallet) account numbers at rest. Base64 for exactly 32 bytes. Required always
# (there's no safe default). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# --- Seeds ---
# Demo password for `npm run seed:demo` (random one is generated and printed if empty).
DEMO_SEED_PASSWORD=
# Demo seed refuses to run when NODE_ENV=production unless this is true.
ALLOW_DEMO_SEED=false

# --- Live order tracking (optional) -----------------------------------------------------------------
# SECRET server-side Mapbox token (needs only "Directions"). Used to compute arrival times from real driving routes.
# Leave empty and ETAs fall back to a labelled straight-line estimate — tracking still works, just less precise.
# Never reuse the browser's public token here (and never put this one in the frontend).
MAPBOX_ACCESS_TOKEN=

# --- Talk to a Pharmacist (live chat, call, email) ---------------------------------------------------
# Every value is OPTIONAL and every method is disabled — never faked — until it is configured.
# Dedicated pharmacist phone line shown on the "Call" button (tel: link). Without it the app falls back to the customer's
# selected store line, and never to a demo store's number in production. Example: +9779812345678
PHARMACY_PHONE=
# Where "Email a pharmacist" messages are delivered. The email is sent through the NOTIFY_DRIVER=webhook gateway above:
# with NOTIFY_DRIVER=console or disabled the in-app email form is switched off (logging is not delivery).
PHARMACY_SUPPORT_EMAIL=
# Where order/payment/delivery/return messages from the Help page go (same gateway requirement).
GENERAL_SUPPORT_EMAIL=
# A pharmacist counts as online this long after their console's last heartbeat (it beats every ~minute while open).
# PHARMACIST_PRESENCE_TTL_SECONDS=180

# ---- Vaspoor Call (voice calls, customer <-> Vaspoor Shop) ------------------------------------------------------------
# In production calling stays OFF until TURN is configured (cross-network audio needs a relay). Browsers only ever
# receive short-lived TURN credentials derived from CALLS_TURN_SECRET; the secret itself never leaves the server.
# CALLS_ENABLED=true
# CALLS_STUN_URLS=stun:turn.example.com:3478
# CALLS_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# CALLS_TURN_SECRET=            # >= 32 chars; must equal coturn's static-auth-secret
# CALLS_TURN_TTL_SECONDS=3600
# CALLS_ALLOW_STUN_ONLY=false   # true = go live without a relay (some customers on strict networks will get no audio)
# CALLS_RING_SECONDS=45
# CALLS_CONNECT_SECONDS=45
# CALLS_MAX_MINUTES=60
# CALLS_PEER_TIMEOUT_SECONDS=45
# CALLS_SHOP_PRESENCE_TTL_SECONDS=60

# ---- Messaging via Brevo (sign-up OTPs, password resets, support email). Replaces the webhook gateway. -------------
# NOTIFY_DRIVER=brevo
# BREVO_API_KEY=                 # Brevo > SMTP & API > API keys (server only; never put it in the frontend)
# BREVO_SENDER_EMAIL=            # must be a verified sender in Brevo (Senders, Domains & Dedicated IPs)
# BREVO_SENDER_NAME=Vaspoor
# BREVO_SMS_SENDER=Vaspoor          # 1-11 letters/digits, no spaces; some countries require this to be registered
# BREVO_SMS_COUNTRY_CODE=977     # prefixed to 10-digit national numbers (Nepal)
