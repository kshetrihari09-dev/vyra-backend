# Copy to .env and fill in. NEVER commit .env. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database (PostgreSQL 13+) ---
DATABASE_URL=postgres://vyra:CHANGE_ME@localhost:5432/vyra
# Set true for managed Postgres (e.g. RDS). DB_SSL_REJECT_UNAUTHORIZED=false only if you cannot supply the CA.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# --- Auth secrets (>= 32 chars, different from each other) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- HTTP ---
# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGIN=http://localhost:5173
# Number of reverse-proxy hops in front of Node (Nginx = 1; Vercel proxy = 1, +1 for a host load balancer like Render/Railway).
# Needed for correct client IPs / rate limiting — with 0 behind a proxy, all users share one rate-limit bucket.
TRUST_PROXY=0
# Public URL of the web app (used to build password-reset links).
APP_URL=http://localhost:5173
# Cookies are Secure by default in production. Override only if needed.
COOKIE_SECURE=
COOKIE_DOMAIN=                   # leave EMPTY behind the Vercel /api proxy (cookie belongs to the web app's host)

# --- Notifications (OTP / password reset delivery) ---
# console  = print messages to the server log (development only)
# disabled = refuse to send (safe default until an SMS/email provider is wired in)
NOTIFY_DRIVER=console            # console (dev: logs OTPs!) | disabled | webhook
# NOTIFY_WEBHOOK_URL=https://sms-email-gateway.example.com/send   # required for webhook; https in production
# NOTIFY_WEBHOOK_SECRET=            # >= 32 chars; the gateway verifies X-Vyra-Signature with it
# NOTIFY_TIMEOUT_MS=8000
# JOBS_ENABLED=true                 # outbox worker + retention purge; run in one or several processes
# Development-only fixed OTP so you can test registration without an SMS gateway. Forbidden in production.
OTP_DEV_CODE=1234

# --- Private object storage for prescriptions / documents ---
# Leave blank to use the local-disk driver (var/private-uploads/) — fine for a single-node deployment.
# Set all four to switch to an S3-compatible bucket.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Payments (Phase 5) ---
# Verifies inbound webhooks from the "manual" (bank transfer / wallet reference) provider. Required in production.
PAYMENTS_MANUAL_WEBHOOK_SECRET=

# --- Field-level encryption (Phase 6) ---
# Encrypts seller settlement (bank/wallet) account numbers at rest. Base64 for exactly 32 bytes. Required always
# (there's no safe default). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# --- Seeds ---
# Demo password for `npm run seed:demo` (random one is generated and printed if empty).
DEMO_SEED_PASSWORD=
# Demo seed refuses to run when NODE_ENV=production unless this is true.
ALLOW_DEMO_SEED=false

# --- Live order tracking (optional) -----------------------------------------------------------------
# SECRET server-side Mapbox token (needs only "Directions"). Used to compute arrival times from real driving routes.
# Leave empty and ETAs fall back to a labelled straight-line estimate — tracking still works, just less precise.
# Never reuse the browser's public token here (and never put this one in the frontend).
MAPBOX_ACCESS_TOKEN=
